{
  "name": "iracing-session-launcher",
  "version": "0.4.0-beta.1",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "description": "Windows launcher for iRacing companion apps and overlays.",
  "author": "Lipp Cruz",
  "main": "src/main.js",
  "scripts": {
    "prepare:app": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1 && node scripts/prepare-assets.js",
    "setup:runtime": "node node_modules/electron/install.js",
    "prestart": "npm run prepare:app",
    "start": "electron .",
    "predist": "npm run prepare:app",
    "dist": "electron-builder --win nsis",
    "dist:store": "npm run prepare:app && electron-builder --win appx --x64",
    "test": "node --test tests/*.test.js",
    "test:smoke": "npm run prepare:app && node scripts/smoke-electron.js",
    "test:release": "node scripts/verify-release.js",
    "release:bundle": "node scripts/bundle-release.js"
  },
  "build": {
    "appId": "local.iracing.sessionlauncher",
    "productName": "iRacing Session Launcher",
    "electronLanguages": ["pt-BR", "en-US"],
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "src/main.js",
      "src/preload.js",
      "src/config.js",
      "src/app-controller.js",
      "src/session-monitor.js",
      "src/renderer/index.html",
      "src/renderer/styles.css",
      "src/renderer/renderer.js",
      "src/renderer/vendor/lucide.min.js",
      "src/renderer/vendor/lucide-LICENSE",
      "LICENSE",
      "LICENSE.pt-BR",
      "THIRD_PARTY_NOTICES.txt"
    ],
    "extraResources": [
      {
        "from": "build-assets",
        "to": "build-assets",
        "filter": [
          "SessionProbe.exe",
          "app.ico"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build-assets/app.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "installerLanguages": ["pt_BR", "en_US"],
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "appx": {
      "identityName": "LippCruz.iRacingSessionLauncher",
      "publisher": "CN=1E129E8D-2F04-4242-84F0-E2666F414644",
      "publisherDisplayName": "Lipp Cruz",
      "applicationId": "iRacingSessionLauncher",
      "displayName": "iRacing Session Launcher",
      "languages": ["pt-BR", "en-US"],
      "capabilities": ["runFullTrust"],
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.26100.0",
      "backgroundColor": "#f3f3f3"
    }
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "lucide": "1.41.0",
    "playwright": "1.63.0"
  }
}
